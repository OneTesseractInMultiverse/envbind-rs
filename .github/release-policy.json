    "required_checks": ["Rust 1.85.0", "Rust stable", "Security audit"]
  },
  "trusted_publisher": {
    "owner": "OneTesseractInMultiverse",
    "repository": "envbind-rs",
    "workflow": "publish.yml",
    "environment": "crates-io"
  }
}
